# StudyMood DJ 本地配置示例
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，永不提交。

# LLM 增强解析（可选；留空则全部走内置规则解析）
# 支持任何 OpenAI 兼容接口；默认按 DeepSeek 配置
STUDYMOOD_LLM_API_KEY=
STUDYMOOD_LLM_BASE_URL=https://api.deepseek.com
STUDYMOOD_LLM_MODEL=deepseek-chat

# 网易云登录态（可选；填 MUSIC_U cookie 的值，网页版 F12 → 应用 → Cookie → music.163.com 里复制）
# 提供后「网易云歌单导入」可读取你账号的全部歌单（含私密歌单），否则匿名只能读公开歌单前 10 首
STUDYMOOD_NETEASE_COOKIE=
